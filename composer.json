{
  "name": "santa-casa/sistema-refeitorio",
  "description": "Sistema interno de agendamento de refeições.",
  "type": "project",
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:operational": [
      "docker build --quiet --tag refeitorio-entrypoint-test .",
      "phpunit --configuration phpunit-operational.xml"
    ],
    "test:all": [
      "@test",
      "@test:operational"
    ]
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0"
  }
}
