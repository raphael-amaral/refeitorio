APP_ENV=              # development | production
COMPOSE_PROJECT_NAME= # refeitorio-teste (teste) | refeitorio (prod)

WEB_PORT=             # 8151 (teste) | 8101 (prod)
DB_PORT_EXTERNAL=     # 3151 (teste) | 3101 (prod)

DB_HOST=db
DB_PORT=3306
DB_DATABASE=          # refeitorio_teste (teste) | refeitorio_snd (prod)
DB_USERNAME=
DB_PASSWORD=
SCANNER_TOKEN=

VALOR_REFEICAO=       # valor fixo (R$) por refeição usado na exportação Questor, só muda por decisão da direção

AGENDAMENTO_HABILITADO=false
AGENDAMENTO_SABADO_DOMINGO=false
LIMIT_TIME=10:00
EXCECAO_LIMIT_TIME=13:30

SESSION_IDLE_TIMEOUT=1800
SESSION_SAMESITE=Lax
SESSION_NAME=          # nome do cookie de sessão, deve ser único por ambiente/porta

LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_SECONDS=300
LOGIN_LOCKOUT_SECONDS=300

API_LOGIN_MAX_ATTEMPTS=8
API_LOGIN_WINDOW_SECONDS=300
API_LOGIN_LOCKOUT_SECONDS=300

AUDIT_LOG_PATH=

CONTAINER_NAME=    # refeitorio-teste-db-1 (teste) | refeitorio-db-1 (prod)
BACKUP_DIR=        # caminho absoluto para o diretório de backups